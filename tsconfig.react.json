{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@malilion/ui/editor": [
        "./src/editor.ts"
      ],
      "@malilion/ui/react/editor": [
        "./src/react/editor.tsx"
      ],
      "@malilion/ui": [
        "./src/index.ts"
      ],
      "@malilion/ui/react": [
        "./src/react/index.ts"
      ]
    }
  },
  "include": [
    "src/react/**/*",
    "tests/react/**/*",
    "playground/react/**/*"
  ],
  "exclude": []
}
