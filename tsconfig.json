{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@malilion/ui/editor": [
        "./src/editor.ts"
      ],
      "@malilion/ui": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "playground/**/*",
    "tests/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "src/react/**/*",
    "tests/react/**/*",
    "playground/react/**/*"
  ]
}
