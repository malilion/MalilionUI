{
  "name": "@malilion/ui",
  "version": "0.9.0",
  "description": "Malilion (碼力獅) Vue 3 component library — lion × tech × metal, with cute paw prints",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "component-library",
    "ui",
    "design-system",
    "typescript",
    "malilion",
    "lion",
    "dark-theme"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Malilion",
  "homepage": "https://malilion.github.io/MalilionUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malilion/MalilionUI.git"
  },
  "bugs": {
    "url": "https://github.com/malilion/MalilionUI/issues"
  },
  "sideEffects": [
    "**/*.css",
    "./src/styles/on-demand/*.js"
  ],
  "main": "./dist/malilion-ui.js",
  "module": "./dist/malilion-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/malilion-ui.js"
    },
    "./on-demand/*": "./src/styles/on-demand/*.js",
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./nuxt": {
      "types": "./dist/types/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./resolver": {
      "types": "./dist/types/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./style.css": "./dist/style.css",
    "./css/*": "./src/styles/*",
    "./package.json": "./package.json",
    "./assets/*": "./src/assets/*",
    "./fonts/*": "./src/fonts/*"
  },
  "files": [
    "dist",
    "src/styles",
    "src/assets",
    "src/fonts"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "node scripts/build-style-map.mjs --check && vite build && vue-tsc -p tsconfig.build.json && tsc -p tsconfig.react.build.json",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.react.json",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "styles:map": "node scripts/build-style-map.mjs",
    "styles:check": "node scripts/check-on-demand.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
