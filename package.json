{
  "name": "@malilion/ui",
  "version": "0.2.0",
  "description": "碼力獅 MalilionUI — 獅子 × 科技 × 金屬 的 Vue 3 元件庫",
  "type": "module",
  "license": "MIT",
  "author": "Malilion",
  "homepage": "https://malilion.github.io/MalilionUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malilion/MalilionUI.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/malilion-ui.js",
  "module": "./dist/malilion-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/malilion-ui.js"
    },
    "./style.css": "./dist/style.css",
    "./css/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
